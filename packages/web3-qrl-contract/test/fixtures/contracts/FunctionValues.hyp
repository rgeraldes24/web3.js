pragma hyperion >=0.1.0;

contract FunctionValues {
	event FunctionObserved(
		function(uint256) external pure returns (uint256) indexed indexedCallback,
		function(uint256) external pure returns (uint256) callback,
		uint256 result
	);

	function plusOne(uint256 value) external pure returns (uint256) {
		return value + 1;
	}

	function exerciseFunction(
		function(uint256) external pure returns (uint256) callback,
		uint256 value
	)
		external
		returns (
			function(uint256) external pure returns (uint256),
			uint256
		)
	{
		uint256 result = callback(value);
		emit FunctionObserved(callback, callback, result);
		return (callback, result);
	}
}
